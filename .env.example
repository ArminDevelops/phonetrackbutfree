# Copy to .env and adjust. Every value is optional; the defaults are shown.

# Dashboard address. Keep 127.0.0.1 so only this Mac can reach it.
PORT=4321
HOST=127.0.0.1

# Where the SQLite database lives.
DATA_DIR=./data

# Seconds between checks (±20 % jitter). Apple blocks IPs that poll too fast.
POLL_INTERVAL_SECONDS=30
# Hard cap on requests to Apple per hour; the interval stretches to respect it.
MAX_REQUESTS_PER_HOUR=150
# Swiss postcode used for the store search; 8001 (Zürich) returns all 4 stores.
APPLE_LOCATION=8001

# ntfy server and topic. Leave NTFY_TOPIC empty to auto-generate a private one.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Optional access token (only needed for protected topics / self-hosted servers).
NTFY_TOKEN=

# Don't push the same config/store again within this many minutes (flap guard).
RENOTIFY_COOLDOWN_MINUTES=10
# Push a warning when checking has failed for this long.
HEALTH_ALERT_AFTER_MINUTES=15
# Push "resumed" when the checker was paused (Mac asleep) at least this long.
PAUSE_ALERT_AFTER_MINUTES=30

# Extra host names the dashboard answers to (comma-separated), e.g. a subdomain
# behind nginx. 127.0.0.1, localhost and ::1 are always allowed.
ALLOWED_HOSTS=

# Optional basic auth for the dashboard (set both). Use it whenever the dashboard
# is reachable from anywhere but this machine, and only over HTTPS.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Optional dead-man's switch, e.g. a healthchecks.io ping URL. Pinged at most
# every 5 minutes after a successful check.
HEARTBEAT_URL=
